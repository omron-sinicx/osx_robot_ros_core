<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>osx_msgs</name>
  <version>0.6.0</version>
  <description>ROS 2 interfaces for the OSX project. Slimmed during the ROS 2 migration:
    only RobotStatus remains; the vision messages/services/actions were dropped.</description>
  <author email="fvdrigalski@gmail.com">Felix v. Drigalski</author>
  <maintainer email="cristian.beltran@sinicx.com">Cristian C. Beltran-Hernandez</maintainer>

  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
