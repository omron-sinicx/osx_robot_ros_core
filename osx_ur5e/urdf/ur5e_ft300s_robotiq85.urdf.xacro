<?xml version="1.0"?>
<!-- UR5e with a Robotiq FT300-S force-torque sensor sandwiched between the
     tool flange and a Robotiq 2F-85 gripper.

     The FT300-S shares the FT300 mounting envelope (41.5 mm overall height,
     identical by Robotiq design), so the official ros-industrial robotiq_ft300
     macro is reused for the kinematic chain. The macro's mass/CoM were
     originally the FT300 values (300 g) — we now override them in
     robotiq_ft300.urdf.xacro itself with the FT300-S figures (442 g, CoM
     (-6, 0, 13.5) mm in the measurement frame, manual section 5.2.1).
     Similarly, the 2F-85 base mass in robotiq_arg2f.xacro is bumped to make
     the assembled gripper match the catalog 0.925 kg. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5e_ft300s_robotiq85">

  <!-- UR5e parameters -->
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/ur5e/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/ur5e/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/ur5e/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/ur5e/visual_parameters.yaml"/>
  <xacro:arg name="transmission_hw_interface" default="hardware_interface/PositionJointInterface"/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>

  <!-- Include UR macro -->
  <xacro:include filename="$(find ur_description)/urdf/inc/ur5e_macro.xacro"/>

  <!-- Include Robotiq 2F-85 macro -->
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_85_gripper.urdf.xacro"/>

  <!-- Include official ros-industrial Robotiq FT300 macro (sensor + mounting plate) -->
  <xacro:include filename="$(find robotiq_ft_sensor)/urdf/robotiq_ft300.urdf.xacro"/>

  <!-- Instantiate UR5e -->
  <xacro:ur5e_robot prefix=""
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    transmission_hw_interface="$(arg transmission_hw_interface)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"/>

  <!-- Attach Robotiq FT300-S (mounting plate + sensor) to the UR flange (tool0).
       The official macro builds along +Z, and tool0 Z points forward, so an
       identity origin mounts the plate flush on the flange. The assembly tool
       face ends up at tool0 Z = 0.0415 m (13 mm plate + sensor body). -->
  <xacro:robotiq_ft300 prefix="" parent="tool0">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_ft300>

  <!-- Attach Robotiq 2F-85 to the FT300-S tool face.
       ft300_mounting_plate shares tool0's orientation, so place the gripper
       0.0415 m forward (tool0 Z) and reuse the orientation that maps the
       gripper X axis to the forward direction. -->
  <xacro:robotiq_85_gripper prefix="" parent="ft300_mounting_plate">
    <origin xyz="0 0 0.0415" rpy="0 ${-pi/2} ${pi/2}"/>
  </xacro:robotiq_85_gripper>

  <!-- TCP: gripper tip link. 169.9 mm = measured tool0→tip (211.4 mm) minus
       the 41.5 mm FT300-S stack above. -->
  <joint name="gripper_tip_joint" type="fixed">
    <parent link="robotiq_85_base_link"/>
    <child link="gripper_tip_link"/>
    <origin xyz="0.1699 0 0" rpy="0 0 0"/>
  </joint>
  <link name="gripper_tip_link"/>

</robot>
