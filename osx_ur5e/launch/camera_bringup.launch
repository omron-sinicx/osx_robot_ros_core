<?xml version="1.0"?>
<launch>

  <arg name="camera_name"	value="wrist_camera"/>
  
  <arg name="camera_serial_no"	value="143322073059"/>
  <arg name="camera_fps"	default="30"/>
  <arg name="depth_fps"	  default="$(arg camera_fps)"/>
  <arg name="camera_width"	default="640"/>
  <arg name="camera_height"	default="480"/>
  <arg name="initial_reset"	default="false"/>
  <arg name="enable_depth"	default="false"/>

  <!-- Mains frequency used by the color sensor's anti-flicker auto-exposure.
       Values follow librealsense RS2_OPTION_POWER_LINE_FREQUENCY:
       0=Off, 1=50Hz, 2=60Hz, 3=Auto. Set to 50Hz for eastern Japan. -->
  <arg name="power_line_frequency"	default="1"/>

  <!-- Manual color settings for the wrist camera, tuned to match the
       ur5e-pick-cube-15 demo brightness (mean ~95-98) without flicker:
       exposure 100 = 10 ms is the shortest flicker-safe integration under
       50 Hz lighting, which alone reads too bright, so gain sits at its
       minimum and a negative ISP brightness offset recovers the demo level.
       Auto-exposure must be off for the manual values to apply;
       power_line_frequency only matters while auto-exposure is on. -->
  <arg name="wrist_camera_auto_exposure"	default="true"/>
  <arg name="wrist_camera_exposure"	default="100"/>
  <arg name="wrist_camera_gain"	default="0"/>
  <arg name="wrist_camera_brightness"	default="0"/>

  <param name="$(arg camera_name)/rgb_camera/power_line_frequency"
         value="$(arg power_line_frequency)"/>
  <param name="$(arg camera_name)/rgb_camera/enable_auto_exposure"
         value="$(arg wrist_camera_auto_exposure)"/>
  <param name="$(arg camera_name)/rgb_camera/exposure"
         value="$(arg wrist_camera_exposure)"/>
  <param name="$(arg camera_name)/rgb_camera/gain"
         value="$(arg wrist_camera_gain)"/>
  <param name="$(arg camera_name)/rgb_camera/brightness"
         value="$(arg wrist_camera_brightness)"/>

  <!-- Auto-exposure metering window, in pixels of the 640x480 colour frame:
       left/right are columns (0..639), top/bottom are rows (0..479). The
       wrapper reads these into the region of interest it pushes to the sensor
       once the first frame arrives, so setting them here fixes the ROI from
       startup. They matter only while auto-exposure is on.

       The wrist camera meters on the whole frame, inset by 1 px per side: the
       exact full frame is not a legal ROI, the firmware rejects it and
       librealsense logs
         hwmon command 0x75( 0 1df 0 27f ) failed (response -6= Invalid parameter)
       where 0x27f=639 and 0x1df=479. -->
  <arg name="wrist_ae_roi_left"	default="1"/>
  <arg name="wrist_ae_roi_right"	default="638"/>
  <arg name="wrist_ae_roi_top"	default="1"/>
  <arg name="wrist_ae_roi_bottom"	default="478"/>

  <param name="$(arg camera_name)/rgb_camera/auto_exposure_roi/left"
         value="$(arg wrist_ae_roi_left)"/>
  <param name="$(arg camera_name)/rgb_camera/auto_exposure_roi/right"
         value="$(arg wrist_ae_roi_right)"/>
  <param name="$(arg camera_name)/rgb_camera/auto_exposure_roi/top"
         value="$(arg wrist_ae_roi_top)"/>
  <param name="$(arg camera_name)/rgb_camera/auto_exposure_roi/bottom"
         value="$(arg wrist_ae_roi_bottom)"/>

  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera"		    value="$(arg camera_name)"/>
    <arg name="serial_no"           value="$(arg camera_serial_no)"/>
    <arg name="tf_prefix"	    value="calibrated_$(arg camera_name)"/>
    <arg name="enable_pointcloud"   value="false"/>
    <arg name="align_depth"         value="$(arg enable_depth)"/>
    <arg name="fisheye_fps"         value="$(arg camera_fps)"/>
    <arg name="depth_width"         value="$(arg camera_width)"/>
    <arg name="depth_height"        value="$(arg camera_height)"/>
    <arg name="depth_fps"           value="$(arg depth_fps)"/>
    <arg name="color_fps"           value="$(arg camera_fps)"/>
    <arg name="color_width"         value="$(arg camera_width)"/>
    <arg name="color_height"        value="$(arg camera_height)"/>
    <arg name="enable_infra1"       value="false"/>
    <arg name="enable_infra2"       value="false"/>
    <arg name="initial_reset"       value="$(arg initial_reset)"/>
    <arg name="enable_depth"       value="$(arg enable_depth)"/>
  </include>

  <arg name="camera_name2"	value="front_camera"/>

  <arg name="camera_serial_no2"	value="231522071541"/>
  <!-- 141722063620 -->

  <!-- Manual color settings for the front camera, tuned to match the
       ur5e-pick-cube-15 demo brightness (mean ~60) without flicker:
       exposure 100 = 10 ms (flicker-safe under 50 Hz lighting) with minimum
       gain lands on the demo level directly. Auto-exposure must be off for
       the manual values to apply; power_line_frequency only matters while
       auto-exposure is on. -->
  <arg name="front_camera_auto_exposure"	default="true"/>
  <arg name="front_camera_exposure"	default="100"/>
  <arg name="front_camera_gain"	default="0"/>
  <arg name="front_camera_brightness"	default="15"/>

  <param name="$(arg camera_name2)/rgb_camera/power_line_frequency"
         value="$(arg power_line_frequency)"/>
  <param name="$(arg camera_name2)/rgb_camera/enable_auto_exposure"
         value="$(arg front_camera_auto_exposure)"/>
  <param name="$(arg camera_name2)/rgb_camera/exposure"
         value="$(arg front_camera_exposure)"/>
  <param name="$(arg camera_name2)/rgb_camera/gain"
         value="$(arg front_camera_gain)"/>
  <param name="$(arg camera_name2)/rgb_camera/brightness"
         value="$(arg front_camera_brightness)"/>

  <!-- Front camera meters on the workspace only: columns 160..480, lower half
       of the frame (rows 240..479). See the wrist camera block above. -->
  <arg name="front_ae_roi_left"	default="160"/>
  <arg name="front_ae_roi_right"	default="480"/>
  <arg name="front_ae_roi_top"	default="240"/>
  <arg name="front_ae_roi_bottom"	default="479"/>

  <param name="$(arg camera_name2)/rgb_camera/auto_exposure_roi/left"
         value="$(arg front_ae_roi_left)"/>
  <param name="$(arg camera_name2)/rgb_camera/auto_exposure_roi/right"
         value="$(arg front_ae_roi_right)"/>
  <param name="$(arg camera_name2)/rgb_camera/auto_exposure_roi/top"
         value="$(arg front_ae_roi_top)"/>
  <param name="$(arg camera_name2)/rgb_camera/auto_exposure_roi/bottom"
         value="$(arg front_ae_roi_bottom)"/>

  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera"		    value="$(arg camera_name2)"/>
    <arg name="serial_no"           value="$(arg camera_serial_no2)"/>
    <arg name="tf_prefix"	    value="calibrated_$(arg camera_name2)"/>
    <!-- <arg name="enable_pointcloud"   value="false"/> -->
    <arg name="align_depth"         value="$(arg enable_depth)"/>
    <!-- <arg name="fisheye_fps"         value="$(arg camera_fps)"/> -->
    <arg name="depth_width"         value="$(arg camera_width)"/>
    <arg name="depth_height"        value="$(arg camera_height)"/>
    <arg name="depth_fps"           value="$(arg depth_fps)"/>
    <arg name="color_fps"           value="$(arg camera_fps)"/>
    <arg name="color_width"         value="$(arg camera_width)"/>
    <arg name="color_height"        value="$(arg camera_height)"/>
    <!-- <arg name="enable_infra1"       value="false"/>
    <arg name="enable_infra2"       value="false"/> -->
    <arg name="initial_reset"       value="$(arg initial_reset)"/>
    <arg name="enable_depth"       value="$(arg enable_depth)"/>
  </include>
<!-- 
  <include file="$(find osx_scene_description)/launch/publish_camera_calibration.launch">
    <arg name="camera_name"	value="$(arg camera_name)"/>
  </include>

  <node name="dummy_calibrated_$(arg camera_name)" pkg="tf" type="static_transform_publisher"
        args="0 0 0 0 0 0 world calibrated_$(arg camera_name)_link 10"/> -->

</launch>
