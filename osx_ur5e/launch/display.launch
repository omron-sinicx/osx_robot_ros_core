<?xml version="1.0"?>
<launch>
  
  <param name="robot_description" command="$(find xacro)/xacro --inorder '$(find osx_ur5e)/urdf/scene.urdf.xacro'" />
  
  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher">
    <rosparam param="zeros">
      shoulder_pan_joint: 1.57
      shoulder_lift_joint: -2.1
      elbow_joint: 1.4
      wrist_1_joint: -0.85
      wrist_2_joint: -1.57
      wrist_3_joint: 0.0
    </rosparam>
  </node>

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
  
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find osx_ur5e)/config/default-display.rviz" required="true" />
</launch>
