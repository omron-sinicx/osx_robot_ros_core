<?xml version="1.0"?>
<launch>

  <arg name="camera_name"	value="wrist_camera"/>
  
  <arg name="camera_serial_no"	value="143322073059"/>
  <arg name="camera_fps"	default="30"/>
  <arg name="depth_fps"	  default="$(arg camera_fps)"/>
  <arg name="camera_width"	default="1280"/>
  <arg name="camera_height"	default="720"/>
  <arg name="initial_reset"	default="true"/>
  <arg name="enable_depth"	default="false"/>
  
 
  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera"		    value="$(arg camera_name)"/>
    <arg name="serial_no"           value="$(arg camera_serial_no)"/>
    <arg name="tf_prefix"	    value="calibrated_$(arg camera_name)"/>
    <arg name="enable_pointcloud"   value="false"/>
    <arg name="align_depth"         value="$(arg enable_depth)"/>
    <arg name="fisheye_fps"         value="$(arg camera_fps)"/>
    <arg name="depth_width"         value="$(arg camera_width)"/>
    <arg name="depth_height"        value="$(arg camera_height)"/>
    <arg name="depth_fps"           value="$(arg depth_fps)"/>
    <arg name="color_fps"           value="$(arg camera_fps)"/>
    <arg name="color_width"         value="$(arg camera_width)"/>
    <arg name="color_height"        value="$(arg camera_height)"/>
    <arg name="enable_infra1"       value="false"/>
    <arg name="enable_infra2"       value="false"/>
    <arg name="initial_reset"       value="$(arg initial_reset)"/>
    <arg name="enable_depth"       value="$(arg enable_depth)"/>
  </include>

  <arg name="camera_name2"	value="front_camera"/>
  <arg name="camera_serial_no2"	value="141722063620"/>

  <include file="$(find timed_roslaunch)/launch/timed_roslaunch.launch">
    <arg name="time" value="5" />
    <arg name="pkg" value="osx_ur5e" />
    <arg name="file" value="osx_bringup_single_camera.launch" />
    <arg name="node_name" value="cam1" />
    <arg name="value" value="camera_name:=$(arg camera_name2)
                             camera_serial_no:=$(arg camera_serial_no2)
                             camera_fps:=$(arg camera_fps)
                             camera_width:=$(arg camera_width)
                             camera_height:=$(arg camera_height)
                             initial_reset:=$(arg initial_reset)" />
  </include>
</launch>
