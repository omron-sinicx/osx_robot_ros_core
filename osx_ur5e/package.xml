<?xml version="1.0"?>
<package format="2">
  <name>osx_ur5e</name>
  <version>0.0.0</version>
  <description>The osx_ur5e package has the configuration to connect to a single real robot</description>

  <maintainer email="cristianbehe@gmail.com">Cristian Beltran</maintainer>

  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>cv_bridge</build_depend>
  <build_depend>ur_client_library</build_depend>
  <build_depend>ur_robot_driver</build_depend>
  <build_depend>realsense2_camera</build_depend>
  <build_depend>usb_cam</build_depend>
  <build_export_depend>rospy</build_export_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>ur_client_library</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>v4l-utils</exec_depend>
  <exec_depend>image_transport</exec_depend>
</package>
