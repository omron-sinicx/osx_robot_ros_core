<?xml version="1.0"?>
<!--
  Hand-Eye Calibration GUI launch (eye-to-hand).
  Uses the single UR5e + Robotiq85 SRDF (no a_bot/b_bot prefix).

  This launch only brings up MoveIt + RViz with the HandEyeCalibration panel.
  The camera must be started separately (e.g., osx_bringup_d455s.launch).

  Usage:
    # 1) Robot driver
    roslaunch osx_ur5e connect_real_robot.launch

    # 2) Camera bringup (choose one, depending on which camera to calibrate)
    roslaunch osx_scene_description osx_bringup_d455s.launch
    # or single camera: roslaunch osx_scene_description osx_bringup_d455_<serial>.launch

    # 3) Calibration GUI (camera is selected in the RViz panel, not here)
    roslaunch osx_moveit_config handeye_calibration.launch

  The camera to calibrate is chosen entirely in the RViz HandEyeCalibration
  panel's Context tab (sensor frame + image/camera_info topics). This launch
  only starts MoveIt + RViz and is camera-agnostic.

  RViz HandEyeCalibration panel — Context tab settings (example for d455_1):
    Sensor configuration: Eye-to-hand
    Sensor frame:         d455_1_color_optical_frame
    Object frame:         handeye_target  (appears after target detection)
    End-effector frame:   gripper_tip_link
    Robot base frame:     base_link
    Planning group:       manipulator
    image_topic:          /d455_1/color/image_rect       (rectified, see rectify_d455_color)
    camera_info_topic:    /d455_1/color/camera_info_rect
-->
<launch>
  <arg name="debug" default="false"/>

  <!-- Override SRDF for single robot (not dual-arm) -->
  <param name="robot_description_semantic"
         textfile="$(find osx_ur5e)/config/ur5e_robotiq85.srdf"/>

  <!-- Kinematics config for single robot -->
  <group ns="robot_description_kinematics">
    <param name="manipulator/kinematics_solver" value="kdl_kinematics_plugin/KDLKinematicsPlugin"/>
    <param name="manipulator/kinematics_solver_search_resolution" value="0.005"/>
    <param name="manipulator/kinematics_solver_timeout" value="0.05"/>
  </group>

  <!-- Clear any stale planning-pipeline params from previous (e.g. dual-arm)
       sessions on this ROS master. Without this, residual a_bot/b_bot/ab_bot
       group configs cause move_group to crash on "Group 'a_bot' was not found". -->
  <rosparam command="delete" param="/move_group/planning_pipelines/ompl"/>

  <!-- OMPL planning pipeline (single-arm config; avoids dual-arm groups in default yaml) -->
  <group ns="move_group/planning_pipelines/ompl">
    <param name="planning_plugin" value="ompl_interface/OMPLPlanner"/>
    <param name="request_adapters"
           value="default_planner_request_adapters/AddTimeOptimalParameterization
                  default_planner_request_adapters/FixWorkspaceBounds
                  default_planner_request_adapters/FixStartStateBounds
                  default_planner_request_adapters/FixStartStateCollision
                  default_planner_request_adapters/FixStartStatePathConstraints"/>
    <param name="start_state_max_bounds_error" value="0.1"/>
    <param name="jiggle_fraction" value="0.05"/>
    <rosparam command="load" file="$(find osx_moveit_config)/config/ompl_planning_single_arm.yaml"/>
  </group>

  <!-- Launch MoveIt move_group with single-robot config -->
  <node name="move_group" pkg="moveit_ros_move_group" type="move_group"
        respawn="false" output="screen">
    <param name="allow_trajectory_execution" value="true"/>
    <param name="max_safe_path_cost" value="1"/>
    <param name="jiggle_fraction" value="0.05"/>
    <param name="default_planning_pipeline" value="ompl"/>
    <param name="capabilities" value="move_group/TfPublisher"/>
    <param name="planning_scene_monitor/publish_planning_scene" value="true"/>
    <param name="planning_scene_monitor/publish_geometry_updates" value="true"/>
    <param name="planning_scene_monitor/publish_state_updates" value="true"/>
    <param name="planning_scene_monitor/publish_transforms_updates" value="true"/>
  </node>

  <!-- Launch RViz with HandEyeCalibration panel -->
  <include file="$(find osx_moveit_config)/launch/moveit_rviz.launch">
    <arg name="debug"       value="$(arg debug)"/>
    <arg name="rviz_config" value="$(find osx_moveit_config)/launch/handeye_calibration.rviz"/>
  </include>

</launch>
