<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>osx_examples</name>
  <version>0.2.0</version>
  <description>Interactive motion-planning and direct-control examples (ROS 2 port).</description>

  <maintainer email="cristian.beltran@sinicx.com">Cristian Beltran</maintainer>
  <license>BSD</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ur_control</depend>

  <exec_depend>moveit_py</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>ur_gripper_gz_moveit_config</exec_depend>
  <exec_depend>ur_gripper_gz</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>

  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
